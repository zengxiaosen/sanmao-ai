# Claude API key for LLM text extraction. Do not commit real keys.
# Used by src/quant_llm/llm_extractor.py (Anthropic SDK reads ANTHROPIC_API_KEY automatically).
ANTHROPIC_API_KEY=

# Market data provider keys. Do not commit real keys.
ALPHA_VANTAGE_API_KEY=
TIINGO_API_KEY=

# FRED (macro indicators: Fed funds, Treasury yields). Free key from https://fred.stlouisfed.org.
# Optional — macro.py falls back to yfinance (^VIX/^TNX/DX-Y.NYB) when unset.
FRED_API_KEY=

# PostgreSQL for quant results (factors/signals/backtest). Do not commit real password.
# The quant pipeline writes quant_* tables here; the FastAPI dashboard backend reads them.
DATABASE_URL=postgresql+psycopg://sanmao:PASSWORD@127.0.0.1:5432/sanmao

# Alpaca paper trading keys. Do not commit real keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Guojin QMT / miniQMT local settings. Keep real account id out of Git.
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
QMT_CLIENT_PATH=
QMT_SESSION_ID=1001
QMT_TRADING_MODE=paper

# Futu / Moomoo OpenD settings. OpenD must be running before broker integration.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_TRADING_MODE=paper
FUTU_MARKET=HK
