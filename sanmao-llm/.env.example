HF_HOME=/root/autodl-tmp/hf
TRANSFORMERS_CACHE=/root/autodl-tmp/hf/transformers
HF_HUB_CACHE=/root/autodl-tmp/hf/hub

# Market data provider keys. Do not commit real keys.
ALPHA_VANTAGE_API_KEY=
TIINGO_API_KEY=

# Alpaca paper trading keys. Do not commit real keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Guojin QMT / miniQMT local settings. Keep real account id out of Git.
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
QMT_CLIENT_PATH=
QMT_SESSION_ID=1001
QMT_TRADING_MODE=paper

# Futu / Moomoo OpenD settings. OpenD must be running before broker integration.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_TRADING_MODE=paper
FUTU_MARKET=HK
